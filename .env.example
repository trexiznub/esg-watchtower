# Copy to .env.local for local development. On GitHub, set these as repository
# VARIABLES (Settings > Secrets and variables > Actions > Variables), not secrets:
# every VITE_ value is compiled into public JavaScript and can be read by anyone.
# Never put an API key, a Supabase service-role key or an AI provider key here.

# Base URL of your backend API. Leave empty to run in demo mode.
VITE_API_BASE_URL=

# Set to "true" to force demo mode even when VITE_API_BASE_URL is set.
VITE_DEMO_MODE=

# Set to "true" if the backend uses cookie sessions (sends credentials with requests).
VITE_API_WITH_CREDENTIALS=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=12000
